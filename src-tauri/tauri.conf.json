{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redrob VectorDB",
  "version": "0.1.0",
  "identifier": "ai.redrob.vectordb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Redrob VectorDB",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://console.redrob.ai; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "shortDescription": "Private search for everything on your computer",
    "longDescription": "Redrob VectorDB indexes files locally so you can search and ask across everything on your computer without uploading your library.",
    "copyright": "Copyright © 2026 Redrob",
    "licenseFile": "../THIRD_PARTY_NOTICES.md",
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
